# Template des variables d'environnement nécessaires.
# Copier ce fichier en `.env.local` et remplir avec les vraies valeurs.
# En production : configurer dans Vercel → Project Settings → Environment Variables.

# ─── Telegram (notif instantanée groupe leads) ─────────────────
# Bot créé via @BotFather sur Telegram → /newbot
TELEGRAM_BOT_TOKEN=
# ID du chat/groupe Telegram qui reçoit les leads (nombre négatif pour un groupe)
TELEGRAM_CHAT_ID=

# ─── Notion (base "Prospects" dans la page "Rénovation") ────────
# Token d'intégration interne créé sur notion.so/my-integrations
# La page parent "Rénovation" doit être partagée avec cette intégration.
NOTION_TOKEN=
# ID de la base Notion "Prospects" (UUID avec tirets)
NOTION_LEADS_DB_ID=

# ─── Tracking (à venir) ──────────────────────────────────────────
# Meta Pixel ID (16 chiffres)
# NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API token (côté serveur)
# META_CAPI_TOKEN=
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
# NEXT_PUBLIC_GA4_ID=
